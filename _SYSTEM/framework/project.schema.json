{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "rulebook_version",
    "title",
    "canvas",
    "total_frames",
    "caption_mode",
    "seed",
    "scenes",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "motion-unified-2.0"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "rulebook_version": {
      "const": "1.0"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "enum": [
            1280,
            1920,
            720,
            1080
          ]
        },
        "height": {
          "enum": [
            720,
            1080,
            1280,
            1920
          ]
        },
        "fps": {
          "enum": [
            24,
            25,
            30
          ]
        }
      }
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 108000
    },
    "narration_tail_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "caption_mode": {
      "const": "off"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "start_frame",
          "end_frame",
          "source_cues",
          "script",
          "entry",
          "description",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "engine": {
            "enum": [
              "python",
              "blender"
            ]
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "source_cues": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "script": {
            "type": "string",
            "maxLength": 200
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "provenance"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  }
}
