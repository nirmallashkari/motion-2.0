{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rulebook_version",
    "scenes",
    "references"
  ],
  "properties": {
    "rulebook_version": {
      "const": "1.0"
    },
    "references": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "title",
          "excerpt",
          "verified_by_ai"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "verified_by_ai": {
            "const": true
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "visual_goal",
          "main_objects",
          "beats",
          "claims"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "visual_goal": {
            "type": "string",
            "minLength": 20
          },
          "main_objects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_frame",
                "end_frame",
                "kind",
                "action",
                "on_screen_text"
              ],
              "properties": {
                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "kind": {
                  "enum": [
                    "object_action",
                    "object_reveal",
                    "camera_move",
                    "state_change",
                    "visual_comparison",
                    "hold"
                  ]
                },
                "action": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 2000
                },
                "on_screen_text": {
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          "claims": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "basis",
                "source_cues",
                "evidence"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "enum": [
                    "source_only",
                    "verified_reference",
                    "illustrative"
                  ]
                },
                "source_cues": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
